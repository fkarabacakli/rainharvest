# Copy to .env to override the local docker-compose defaults.
# If you change these, update appsettings.Development.json (or user-secrets) to match.
POSTGRES_USER=rainharvest
POSTGRES_PASSWORD=rainharvest-dev
MQTT_API_USER=api
MQTT_API_PASSWORD=api-dev
MQTT_SIM_USER=simulator
MQTT_SIM_PASSWORD=simulator-dev

# --profile full only
API_PORT=5255
PANEL_ORIGIN=http://localhost:5173
SIM_DEVICES=node1,node2
SIM_SCENARIO=normal
SIM_INTERVAL=5
SIM_SPEED=10
